# ============================================================================
#  Conjunction Tracker - environment configuration (operational settings)
#  Copy to ".env" and adjust. NEVER commit the real .env file.
#
#  Per the assignment, all sensitive / deployment-specific values are supplied
#  via environment variables instead of being hardcoded in the source.
# ============================================================================

# --- Data source (CelesTrak SOCRATES bulk conjunction CSV) ---
# One download contains conjunctions for the entire catalog; we filter locally.
SOCRATES_SOURCE_URL=https://celestrak.org/SOCRATES/sort-minRange.csv

# --- Polite-client / anti-ban controls ---
# SOCRATES recomputes ~3x/day, so fetching every 6h captures every update
# while keeping our request footprint minimal.
FETCH_INTERVAL_HOURS=6
# Hard floor between *any* two fetches (protects against manual-refresh abuse).
MIN_FETCH_INTERVAL_MINUTES=60
# CelesTrak asks clients to identify themselves. Use a real contact address.
HTTP_USER_AGENT=Pixxel-FDS-ConjunctionTracker/1.0 (flightdynamics@pixxel.co.in)
HTTP_TIMEOUT_SECONDS=60
HTTP_MAX_RETRIES=4
HTTP_BACKOFF_BASE_SECONDS=5
# Run one fetch at startup so the service is useful immediately.
FETCH_ON_STARTUP=true

# --- Risk classification (Flight Dynamics decision thresholds) ---
# Pc (probability of collision) is the primary maneuver-decision driver; miss
# distance is an independent geometric backstop (SOCRATES Pc is TLE-derived and
# can be optimistic). Defaults follow common practice (e.g. NASA CARA).
PC_RED_THRESHOLD=1e-4
PC_YELLOW_THRESHOLD=1e-7
MISS_RED_KM=1.0
MISS_YELLOW_KM=5.0
# TLE age (days) beyond which a prediction is flagged low-confidence.
STALE_DATA_DAYS=3.0
# A maneuver decision must be made this many hours before TCA.
MANEUVER_LEAD_HOURS=24.0
# Health goes "degraded" once the last successful SOCRATES contact is older
# than this many fetch intervals (e.g. 2 x 6h = 12h without fresh data).
HEALTH_STALE_FACTOR=2.0

# --- Storage ---
# SQLite file. In Docker this lives on a mounted volume so history persists.
DATABASE_PATH=./data/conjunctions.db

# --- Mission config (which satellites we monitor) ---
SATELLITE_CONFIG_PATH=./config/satellites.yaml

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO
